{
  "name": "pixel-pets",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test",
    "check": "node --check src/worker.js && node --check public/app.js && node --check public/game.js && node scripts/check-assets.js",
    "build": "node scripts/build-client.js && npm run check",
    "build:sprites": "node scripts/build-emotion-sprites.mjs",
    "test:sprites": "node --test tests/sprite-integrity.test.js",
    "check:visual-baseline": "node scripts/check-visual-baseline.mjs",
    "audit:modules": "node scripts/audit-unused-modules.mjs",
    "visual:matrix": "node scripts/render-visual-evolution-matrix.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.2-beta",
    "sharp": "0.34.5",
    "wrangler": "^4.0.0"
  }
}
